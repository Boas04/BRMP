HOST=127.0.0.1
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
NODE_ENV=development
DATABASE_PATH=./data/brmp.sqlite
ADMIN_USER=admin
# Jalankan npm run setup untuk membuat hash dan password awal yang acak.
ADMIN_PASSWORD_HASH=
# Opsional. Keduanya wajib untuk mengaktifkan AI generatif/semantic selection.
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_LIMIT=200
AI_TIMEOUT_MS=20000
# Kosongkan jika bukan di balik reverse proxy tunggal. Nilai 1 hanya bila proxy
# menghapus header X-Forwarded-For dari klien dan menulis ulang dengan IP klien.
TRUST_PROXY=0
